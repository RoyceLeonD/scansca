# Antska Configuration
# Copy this file to .env and adjust the values

# Project settings
BINARY_NAME=scansca
BUILD_DIR=bin

# Documentation settings
DOCS_PORT=8090
DOCS_IMAGE_NAME=scansca-docs
DOCS_STATIC_IMAGE_NAME=scansca-docs-static

# Registry settings - Replace these with your actual values
DOCKER_REGISTRY=docker.your-company.com

# Deployment settings - Replace with your actual deployment webhook/endpoint
# DEPLOY_ENDPOINT_DOCS=https://your-deployment-endpoint.com/api/deploy/token