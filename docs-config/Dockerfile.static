FROM python:3.11-alpine

WORKDIR /app

# Install MkDocs and Material theme
RUN pip install mkdocs mkdocs-material

# Copy docs content and config
COPY docs /app/docs
COPY docs-config/mkdocs.static.yml /app/mkdocs.yml

# Build static site
RUN mkdocs build

# Use nginx to serve static content
FROM nginx:alpine

# Copy built site to nginx
COPY --from=0 /app/site /usr/share/nginx/html

# Expose port
EXPOSE 8000

# Configure nginx to use port 8000
RUN sed -i 's/listen       80;/listen       8000;/' /etc/nginx/conf.d/default.conf

# Start nginx
CMD ["nginx", "-g", "daemon off;"]